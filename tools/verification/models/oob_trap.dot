digraph state_automaton {
	{node [shape = plaintext, style=invis, label=""] "__init_idle"};
	{node [shape = ellipse] "idle"};
	{node [shape = plaintext] "trapped"};
	{node [shape = plaintext] "demoted"};
	{node [shape = plaintext] "unwinding"};
	{node [shape = plaintext] "unwinding_demoted"};
	{node [shape = plaintext] "entered"};
	"__init_idle" -> "idle";
	"idle" [label = "idle", color = green3];
	"trapped" [label = "trapped\nclk < timeout_ns"];
	"demoted" [label = "demoted\nclk < timeout_ns"];
	"unwinding" [label = "unwinding\nclk < timeout_ns"];
	"unwinding_demoted" [label = "unwinding_demoted\nclk < timeout_ns"];
	"entered" [label = "entered\nclk < timeout_ns"];
	"idle" -> "entered" [ label = "trap_entry;reset(clk)" ];
	"entered" -> "trapped" [ label = "trap_notify;right_trap == 1;reset(same_trap);reset(clk)" ];
	"trapped" -> "trapped" [ label = "trap_entry" ];
	"unwinding" -> "unwinding" [ label = "trap_entry" ];
	"entered" -> "entered" [ label = "sched_switch;no_kprobe == 1\nirq_entry;not_nmi == 1" ];
	"idle" -> "trapped" [ label = "trap_notify;reset(same_trap);reset(clk)" ];
	"trapped" -> "demoted" [ label = "leave_oob;task_ctx == 1" ];
	"trapped" -> "unwinding" [ label = "trap_unwind;same_trap == 1" ];
	"demoted" -> "unwinding_demoted" [ label = "trap_unwind;same_trap == 1" ];
	"unwinding_demoted" -> "unwinding" [ label = "leave_inband" ];
	"unwinding" -> "idle" [ label = "trap_exit_kernel;irqs_off == 1\ntrap_exit_user;irqs_off == 1" ];
	"unwinding_demoted" -> "idle" [ label = "trap_exit_kernel;irqs_off == 1\ntrap_exit_user;irqs_off == 1" ];
	"idle" -> "idle" [ label = "leave_inband\noob_return" ];
	"idle" -> "idle" [ label = "leave_oob;task_ctx == 1" ];
	"idle" -> "idle" [ label = "sched_switch;no_kprobe == 1" ];
	"trapped" -> "trapped" [ label = "sched_switch;no_kprobe == 1" ];
	"demoted" -> "demoted" [ label = "sched_switch;no_kprobe == 1" ];
	"unwinding" -> "unwinding" [ label = "sched_switch;no_kprobe == 1" ];
	"unwinding_demoted" -> "unwinding_demoted" [ label = "sched_switch;no_kprobe == 1" ];
	"idle" -> "idle" [ label = "irq_entry;not_nmi == 1" ];
	"trapped" -> "trapped" [ label = "irq_entry;not_nmi == 1" ];
	"demoted" -> "demoted" [ label = "irq_entry;not_nmi == 1" ];
	"unwinding" -> "unwinding" [ label = "irq_entry;not_nmi == 1" ];
	"unwinding_demoted" -> "unwinding_demoted" [ label = "irq_entry;not_nmi == 1" ];
	{ rank = min ;
		"__init_idle";
		"idle";
	}
}
